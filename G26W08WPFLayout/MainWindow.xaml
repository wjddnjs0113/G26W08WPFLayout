<Window x:Class="G26W08WPFLayout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:G26W08WPFLayout"
        mc:Ignorable="d"
        Title="Layout" Height="450" Width="400">
    <Border Padding="5" Background="LightGray">
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Height="100">
                    <Rectangle Fill="DeepPink" Width="80" Height="80" Margin="10"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="25">여름밤, 너와 나의 주파수</TextBlock>
                        <TextBlock FontSize="20">데이아워 (DAYOUR)</TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="100">
                    <Rectangle Fill="DeepPink" Width="80" Height="80" Margin="10"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="25">Strawberry Filter</TextBlock>
                        <TextBlock FontSize="20">루시드엘 (Lucid L)</TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="100">
                    <Rectangle Fill="DeepPink" Width="80" Height="80" Margin="10"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="25">Glitch City</TextBlock>
                        <TextBlock FontSize="20">넥시스 (NEXIS)</TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="100">
                    <Rectangle Fill="DeepPink" Width="80" Height="80" Margin="10"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="25">비가 그치면 우리는 서먹해질까</TextBlock>
                        <TextBlock FontSize="20">달과 밤</TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="100">
                    <Rectangle Fill="DeepPink" Width="80" Height="80" Margin="10"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="25">Midnight Blue</TextBlock>
                        <TextBlock FontSize="20">시아 (Siah)</TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="100">
                    <Rectangle Fill="DeepPink" Width="80" Height="80" Margin="10"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="25">신기루 (Mirage)</TextBlock>
                        <TextBlock FontSize="20">엔소닉스 (N-SONIX)</TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
